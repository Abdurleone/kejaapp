# Google Sign-In (expo-auth-session/providers/google) needs a client ID for
# whichever platform is actually running - there is no single ID that works
# across iOS/Android/web. Unset means the "Sign in with Google" button
# doesn't render at all rather than crashing. See docs/Authentication.md for
# how to create all three in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
