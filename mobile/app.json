{
  "expo": {
    "name": "JakezApp",
    "slug": "jakezapp",
    "scheme": "jakezapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jakezapp.mobile"
    },
    "android": {
      "package": "com.jakezapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#046a38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "JakezApp accesses your photos so you can add pictures to your property listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "@sentry/react-native"
    ]
  }
}
