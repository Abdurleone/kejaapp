NODE_ENV=development
PORT=5000
TRUST_PROXY=false
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kejaapp
MONGODB_DB_NAME=kejaapp
DB_REQUIRED=false
MONGODB_CONNECT_RETRIES=5
MONGODB_CONNECT_RETRY_DELAY_MS=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_MAX_AGE_DAYS=30
BCRYPT_SALT_ROUNDS=12
AUTH_COOKIE_NAME=keja_token
REFRESH_COOKIE_NAME=keja_refresh
CSRF_COOKIE_NAME=keja_csrf
AUTH_COOKIE_MAX_AGE_DAYS=7
AUTH_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=50
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=5242880
# STORAGE_DRIVER=local writes uploads to UPLOAD_DIR on disk (default, used by docker-compose).
# STORAGE_DRIVER=s3 writes to any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# and requires the S3_* vars below.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
REDIS_URL=
# Optional, same as REDIS_URL above: unset skips malware scanning on
# property-image uploads entirely (an explicit "not enabled" state). Point at
# a clamd process speaking the INSTREAM protocol (e.g. `docker run -p
# 3310:3310 clamav/clamav:stable` locally) to enable it.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional, same pattern as REDIS_URL/CLAMAV_HOST above: unset skips web push
# delivery entirely (mobile push via Expo is unaffected). Generate a real
# pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kejaapp.example
# Optional, same pattern as REDIS_URL/CLAMAV_HOST/VAPID_* above: unset makes
# POST /api/auth/google 503 instead of Google Sign-In silently failing. See
# docs/Authentication.md for how to create a Web OAuth client ID.
GOOGLE_CLIENT_ID=
PROPERTIES_CACHE_TTL_MS=30000
MOVERS_CACHE_TTL_MS=60000
LOG_DIR=logs

# Scheduled-job thresholds (backend/jobs/, run via `npm run jobs`)
STALE_NUDGE_THRESHOLD_HOURS=48
VIEWING_REMINDER_WINDOW_HOURS=24
STALE_LISTING_FRESHNESS_DAYS=14
REVIEW_PROMPT_LOOKBACK_DAYS=14
